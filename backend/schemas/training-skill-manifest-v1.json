{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOJO 科学 Skill 清单 v1",
  "type": "object",
  "required": ["skillId", "version", "status", "classification", "title", "source", "routeCandidates", "reviewStatus"],
  "properties": {
    "skillId": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "version": {"type": "string"},
    "status": {"enum": ["candidate", "verified", "approved", "deprecated"]},
    "classification": {
      "type": "object",
      "required": ["primary", "labels"],
      "properties": {
        "primary": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
        "labels": {"type": "array", "items": {"type": "string"}}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "id", "rights"],
        "properties": {
          "type": {"enum": ["teacher_upload", "school", "existing_project", "standard", "hackertube_reference", "official_document"]},
          "id": {"type": "string", "minLength": 1},
          "locator": {"type": "string"},
          "rights": {"type": "string", "minLength": 1}
        }
      }
    },
    "inputs": {"type": "array"},
    "outputs": {"type": "array"},
    "routeCandidates": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["live_action", "slide_composite", "diagram_2d", "model_3d", "code_execution", "simulation", "generated_scene"]}
    },
    "forbiddenRoutes": {"type": "array", "items": {"type": "string"}},
    "evidenceCards": {"type": "array", "items": {"type": "string"}},
    "qc": {
      "type": "object",
      "properties": {
        "rulesFile": {"type": "string"},
        "minRules": {"type": "integer", "minimum": 0},
        "positiveSamples": {"type": "integer", "minimum": 0},
        "negativeSamples": {"type": "integer", "minimum": 0}
      }
    },
    "reviewStatus": {
      "type": "object",
      "required": ["reviewer", "status"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "approved"]},
        "reviewedAt": {"type": "string"},
        "productionProjectId": {"type": "string"}
      }
    },
    "reuse": {
      "type": "object",
      "properties": {
        "usedCount": {"type": "integer", "minimum": 0},
        "firstPassRate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "avgFixMinutes": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
